// Reads KV v2 secrets from Vault and exposes them as env vars inside the body.
def withVaultKV(String path, Map keys, Closure body) {
    def secretValues = []
    for (e in keys) {
        secretValues << [envVar: e.key, vaultKey: e.value]
    }
    withVault(
        configuration: [
            vaultUrl: 'http://127.0.0.1:8200',
            vaultCredentialId: 'vault-approle',
            engineVersion: 2
        ],
        vaultSecrets: [[path: path, secretValues: secretValues]]
    ) {
        body()
    }
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        choice(name: 'TRIVY_FAIL_ON', choices: ['CRITICAL', 'HIGH', 'NONE'],
               description: 'Fail the build before pushing if the image has vulnerabilities at this severity or above')
    }

    tools {
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'

        // CHANGE THESE
        REPO_SLUG  = 'OlimovShahboz/-End-to-End-Kubernetes-DevSecOps-Tetris-Project'
        IMAGE_REPO = 'shahboz01/tetris-v1'
        BRANCH     = 'main'
        APP_DIR      = 'Tetris-V1'
        MANIFEST_DIR = 'Manifest-file'
    }

    stages {

        stage('Checkout') {
            steps {
                cleanWs()
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git clone --branch "$BRANCH" "https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO_SLUG}.git" .
                        git remote set-url origin "https://github.com/${REPO_SLUG}.git"
                    '''
                }
                script {
                    def sha = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${sha}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                }
            }
        }

        stage('Code & Dependency Scans') {
            parallel {
                stage('SonarQube Analysis') {
                    steps {
                        dir(env.APP_DIR) {
                            withSonarQubeEnv('sonar-scanner') {
                                sh '''
                                    $SCANNER_HOME/bin/sonar-scanner \
                                      -Dsonar.projectName=Tetris \
                                      -Dsonar.projectKey=Tetris \
                                      -Dsonar.sources=src \
                                      -Dsonar.exclusions=node_modules/**,build/**
                                '''
                            }
                        }
                    }
                }
                stage('OWASP Dependency-Check') {
                    steps {
                        dir(env.APP_DIR) {
                            dependencyCheck(
                                additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                                odcInstallation: 'DP-Check',
                                nvdCredentialsId: 'nvd-api-key'
                            )

                            dependencyCheckPublisher(
                                pattern: '**/dependency-check-report.xml'
                            )
                        }
                    }
                }
                stage('Trivy FS Scan') {
                    steps {
                        dir(env.APP_DIR) {
                            sh 'trivy fs --severity HIGH,CRITICAL --format table -o trivyfs.txt .'
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'docker build --pull -t "$IMAGE_REPO:$IMAGE_TAG" .'
                }
            }
        }

        // Scan BEFORE pushing so a vulnerable image never reaches the registry
        
            stage('Trivy Image Scan') {
                steps {
                    sh '''
                        set -e
                        trivy image \
                        --ignore-unfixed \
                        --format json \
                        --output trivyimage.json \
                        "$IMAGE_REPO:$IMAGE_TAG"
                    '''

                    script {
                        // Print vulnerabilities that meet the selected threshold.
                        def scanSummary = sh(
                            returnStdout: true,
                            script: '''
                                python3 - <<'PY'
            import json
            import os

            threshold = os.environ.get("TRIVY_FAIL_ON", "CRITICAL")
            severity_order = {"LOW": 1, "MEDIUM": 2, "HIGH": 3, "CRITICAL": 4}
            minimum = {"HIGH": 3, "CRITICAL": 4, "NONE": 99}.get(threshold, 4)

            with open("trivyimage.json", encoding="utf-8") as f:
                report = json.load(f)

            findings = []
            for result in report.get("Results") or []:
                for vuln in result.get("Vulnerabilities") or []:
                    severity = vuln.get("Severity", "").upper()
                    if severity_order.get(severity, 0) >= minimum:
                        findings.append((
                            severity,
                            result.get("Target", "unknown"),
                            vuln.get("PkgName", "unknown"),
                            vuln.get("VulnerabilityID", "unknown"),
                            vuln.get("InstalledVersion", "unknown"),
                            vuln.get("FixedVersion", "No fixed version listed"),
                            vuln.get("Title", "No description provided")
                        ))

            findings.sort(key=lambda x: severity_order.get(x[0], 0), reverse=True)

            print("Trivy threshold: " + threshold)
            if findings:
                print("Vulnerabilities requiring review:")
                for severity, target, package, cve, installed, fixed, title in findings:
                    print(f"[{severity}] {cve} | Package: {package}")
                    print(f"  Target: {target}")
                    print(f"  Installed: {installed} | Fixed: {fixed}")
                    print(f"  Reason: {title}")
            else:
                print("No vulnerabilities matched the selected threshold.")

            print(f"TRIVY_GATE_COUNT={len(findings)}")
            PY
                            '''
                        ).trim()

                        echo scanSummary

                        def countMatcher = (scanSummary =~ /TRIVY_GATE_COUNT=(\d+)/)
                        if (!countMatcher.find()) {
                            error('Could not determine Trivy findings count.')
                        }

                        int findingCount = countMatcher.group(1).toInteger()

                        if (findingCount > 0) {
                            echo """
                                SECURITY APPROVAL REQUIRED
                                Trivy found ${findingCount} vulnerability finding(s)
                                at the configured threshold: ${params.TRIVY_FAIL_ON}.
                                Review the package, CVE, installed version, fixed version,
                                and reason printed above before deciding.
                                """

                                 timeout(time: 15, unit: 'MINUTES') {
                                input(
                                    message: "Trivy found ${findingCount} qualifying vulnerability finding(s). Review the console output. Do you approve pushing and deploying this image?",
                                    ok: 'Proceed anyway',
                                    submitterParameter: 'TRIVY_APPROVED_BY'
                                )
                            }

                            echo "Trivy risk accepted by: ${env.TRIVY_APPROVED_BY ?: 'authorized approver'}"
                        } else {
                            echo 'Trivy gate passed. No manual approval is required.'
                        }
                    }
                }
            }


        stage('Docker Push') {
            steps {
                script {
                    withVaultKV('secret/tetris/dockerhub', [DOCKER_USER: 'username', DOCKER_TOKEN: 'token']) {
                        sh '''
                            echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                            docker push "$IMAGE_REPO:$IMAGE_TAG"
                        '''
                    }
                }
            }
        }

        // GitOps: change the image tag in Git; ArgoCD syncs it to EKS
        stage('Update Manifest (GitOps)') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                        dir(env.MANIFEST_DIR) {
                            sh '''
                                set -e
                                sed -i -E "s|image:[[:space:]]*${IMAGE_REPO}:.*|image: ${IMAGE_REPO}:${IMAGE_TAG}|" deployment-service.yml
                                if git diff --quiet; then
                                    echo "Manifest already up to date"; exit 0
                                fi
                                git config user.email "jenkins@tetris.local"
                                git config user.name "jenkins-ci"
                                git add deployment-service.yml
                                git commit -m "ci: deploy ${IMAGE_REPO}:${IMAGE_TAG}"
                                git push "https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO_SLUG}.git" HEAD:${BRANCH}
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '**/trivyfs.txt, trivyimage.txt, trivyimage.json, **/dependency-check-report.*',
                 allowEmptyArchive: true
            sh '''
                docker logout || true
                docker rmi "$IMAGE_REPO:$IMAGE_TAG" || true
                docker image prune -f || true
            '''
            cleanWs()
        }
    }
    
}